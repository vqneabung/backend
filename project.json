{
  "name": "bizflow-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src/main/kotlin",
  "projectType": "application",
  "tags": ["scope:backend", "lang:kotlin", "framework:spring"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew.bat bootJar",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "outputs": ["{projectRoot}/build/libs/**"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew.bat test",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradlew.bat bootRun",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}