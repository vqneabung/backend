# =============================================================================
# Bizflow Backend — Environment Variables (.env)
# =============================================================================
# Copy file này thành .env và điền giá trị phù hợp.
#
#   cp .env.example .env
#
# Các biến có sẵn default trong application.properties — chỉ cần override khi
# khác với giá trị mặc định (chú thích ở mỗi dòng).
# =============================================================================

# ── Database: SQL Server ────────────────────────────────────────────────────
# Format: jdbc:sqlserver://HOST:PORT;databaseName=DB;encrypt=false
# Default: jdbc:sqlserver://localhost:5144;databaseName=bizflow;encrypt=false;trustServerCertificate=true
# DB_URL=

# Default: sa
# DB_USERNAME=

# REQUIRED — không có default trong application.properties
DB_PASSWORD=1234567890

# ── JPA / Hibernate ─────────────────────────────────────────────────────────
# DDL mode: none | validate | update | create | create-drop
# Default: update
# JPA_DDL_AUTO=

# Hiển thị SQL trong log: true | false
# Default: true
# JPA_SHOW_SQL=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Thời gian sống của JWT (milliseconds). Default: 86400000 (24h)
# JWT_EXPIRATION=

# ── OAuth2 Authorization Server ─────────────────────────────────────────────
# Issuer URL (phải khớp với Spring Security config). Default: http://localhost:8080
# AUTH_ISSUER=

# ── OAuth2 Client — Next.js (http://localhost:3000) ─────────────────────────
# Client secret của Next.js client (đăng ký trong OAuth2AuthorizationServerConfig)
# Default: nextjs-secret
# NEXTJS_CLIENT_SECRET=

# Redirect URI sau khi login thành công (phải khớp với registered redirect_uri)
# Default: http://localhost:3000/api/auth/callback/oidc
# NEXTJS_REDIRECT_URI=

# Post-logout redirect URI
# Default: http://localhost:3000/
# NEXTJS_POST_LOGOUT_URI=

# ── OAuth2 Client — Laravel Admin (http://localhost:8000) ───────────────────
# Default: admin-secret
# LARAVEL_CLIENT_SECRET=

# Default: http://localhost:8000/admin/callback
# LARAVEL_REDIRECT_URI=

# ── Frontend URLs ───────────────────────────────────────────────────────────
# Dùng cho CORS và redirect. Default: http://localhost:3000
# FRONTEND_URL=

# Admin panel URL. Default: http://localhost:8000
# ADMIN_URL=
